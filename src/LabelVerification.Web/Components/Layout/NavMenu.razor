@*
    Minimal navigation for the evaluator-facing prototype.

    Framework demonstration routes are intentionally removed so navigation
    contains only capabilities that belong to the label-verification application.
*@

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            Label Verification
        </a>
    </div>
</div>

@* Accessible navigation toggle used by the responsive Blazor layout. *@
<input type="checkbox"
       title="Navigation menu"
       aria-label="Toggle navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column" aria-label="Primary navigation">

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"
                      aria-hidden="true"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="about">
                <span class="bi bi-info-circle-fill-nav-menu"
                      aria-hidden="true"></span>
                About
            </NavLink>
        </div>

    </nav>
</div>