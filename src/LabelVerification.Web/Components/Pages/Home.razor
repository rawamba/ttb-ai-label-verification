@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using LabelVerification.Application.Exceptions
@using LabelVerification.Application.LabelUnderstanding
@using LabelVerification.Application.Verification
@using LabelVerification.Application.Verification.Workflow
@using LabelVerification.Web.Components.Verification
@using LabelVerification.Web.Components.Batch

@inject ILabelVerificationService LabelVerificationService
@inject ILogger<Home> Logger

<PageTitle>Alcohol Label Verification</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-9">

            <header class="mb-4">
                <h1 class="h2 mb-2">
                    Alcohol Label Verification
                </h1>

                <p class="text-secondary mb-0">
                    Select an application, upload label evidence, and compare
                    extracted information with the expected application data.
                </p>
            </header>

            @* ============================================================
               VERIFICATION MODE
               Designed for clear, low-friction mode selection.
               ============================================================ *@

            <section class="mb-4"
                     aria-labelledby="verification-mode-heading">

                <div class="d-flex align-items-start justify-content-between gap-3 mb-3">

                    <div>
                        <div class="text-uppercase fw-semibold text-primary small mb-1">
                            Verification mode
                        </div>

                        <h2 id="verification-mode-heading"
                            class="h4 mb-1">
                            How would you like to verify labels?
                        </h2>

                        <p class="text-secondary mb-0">
                            Choose the option that matches the work you need to do.
                        </p>
                    </div>

                    <button type="button"
                            class="btn btn-outline-secondary rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0"
                            style="width: 2.25rem; height: 2.25rem;"
                            title="Single label verifies one image at a time. Batch upload lets you select multiple labels and review the results together."
                            aria-label="Help choosing a verification mode">
                        <span class="fw-bold"
                              aria-hidden="true">
                            ?
                        </span>
                    </button>

                </div>

                <div class="row g-3"
                     role="group"
                     aria-label="Verification mode">

                    <div class="col-12 col-md-6">

                        <button type="button"
                                class="@GetModeButtonClass(
                                                                    VerificationMode.Single)"
                                aria-pressed="@(
                                _verificationMode ==
                                VerificationMode.Single)"
                                disabled="@_isProcessing"
                                @onclick="() => SetVerificationMode(
                                                                    VerificationMode.Single)">

<span class="@GetModeIconContainerClass(
                                                                  VerificationMode.Single)"
                                  aria-hidden="true">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="4"
                                          y="3"
                                          width="16"
                                          height="18"
                                          rx="2" />

                                    <path d="M8 8h8" />
                                    <path d="M8 12h8" />
                                    <path d="M8 16h5" />

                                </svg>

                            </span>

                            <span class="text-start flex-grow-1">

                                <span class="d-block fw-bold fs-6">
                                    Single label
                                </span>

                                <span class="@GetModeDescriptionClass(
                                                                          VerificationMode.Single)">
                                    Verify one label image
                                </span>

                            </span>

                            @if (_verificationMode ==
                                 VerificationMode.Single)
                            {
                                <span class="ms-auto"
                                      aria-hidden="true">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="20"
                                         height="20"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2.5"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="m5 12 4 4L19 6" />

                                    </svg>

                                </span>
                            }

                        </button>

                    </div>

                    <div class="col-12 col-md-6">

                        <button type="button"
                                class="@GetModeButtonClass(
                                                                    VerificationMode.Batch)"
                                aria-pressed="@(
                                _verificationMode ==
                                VerificationMode.Batch)"
                                disabled="@_isProcessing"
                                @onclick="() => SetVerificationMode(
                                                                    VerificationMode.Batch)">

<span class="@GetModeIconContainerClass(
                                                                  VerificationMode.Batch)"
                                  aria-hidden="true">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="24"
                                     height="24"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3"
                                          y="3"
                                          width="7"
                                          height="7"
                                          rx="1" />

                                    <rect x="14"
                                          y="3"
                                          width="7"
                                          height="7"
                                          rx="1" />

                                    <rect x="3"
                                          y="14"
                                          width="7"
                                          height="7"
                                          rx="1" />

                                    <rect x="14"
                                          y="14"
                                          width="7"
                                          height="7"
                                          rx="1" />

                                </svg>

                            </span>

                            <span class="text-start flex-grow-1">

                                <span class="d-block fw-bold fs-6">
                                    Batch upload
                                </span>

                                <span class="@GetModeDescriptionClass(
                                                                          VerificationMode.Batch)">
                                    Verify multiple labels together
                                </span>

                            </span>

                            @if (_verificationMode ==
                                 VerificationMode.Batch)
                            {
                                <span class="ms-auto"
                                      aria-hidden="true">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="20"
                                         height="20"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2.5"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="m5 12 4 4L19 6" />

                                    </svg>

                                </span>
                            }

                        </button>

                    </div>

                </div>

                <div class="form-text mt-2">
                    <span class="fw-semibold">
                        Tip:
                    </span>

                    Use
                    <span class="text-primary fw-semibold">
                        Single label
                    </span>
                    for one image, or
                    <span class="text-success fw-semibold">
                        Batch upload
                    </span>
                    when reviewing several labels from the same application.
                </div>

            </section>

            @* ============================================================
               SHARED APPLICATION SELECTION
               ============================================================ *@

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <div class="mb-4">
                        <label for="applicationId"
                               class="form-label fw-semibold">
                            1. Application
                        </label>

                        <select id="applicationId"
                                class="form-select form-select-lg"
                                @bind="_selectedApplicationId"
                                disabled="@_isProcessing">

                            <option value="">
                                -- Select an application --
                            </option>

                            @foreach (var application in ApplicationOptions)
                            {
                                <option value="@application.Id">
                                    @application.DisplayName
                                </option>
                            }

                        </select>

                        <div class="form-text">
                            Prototype application data is supplied by the local
                            mock COLA adapter. No direct COLA integration is used.
                        </div>
                    </div>

                    @* ====================================================
                       SINGLE-LABEL MODE
                       ==================================================== *@

                    @if (_verificationMode ==
                         VerificationMode.Single)
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                2. Label image
                            </label>

                            <InputFile OnChange="OnFileSelected"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       class="form-control form-control-lg"
                                       disabled="@_isProcessing" />

                            <div class="form-text">
                                Supported formats: JPEG, PNG, and WebP.
                                Maximum upload size: 10 MB.
                            </div>

                            @if (_selectedFile is not null)
                            {
                                <div class="mt-2 small">
                                    <span class="fw-semibold">
                                        Selected:
                                    </span>

                                    @_selectedFile.Name

                                    <span class="text-secondary">
                                        (@FormatFileSize(
                                                                                    _selectedFile.Size))
                                    </span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                                 _validationError))
                        {
                            <div class="alert alert-danger"
                                 role="alert">

                                <strong>
                                    Unable to verify this label.
                                </strong>

                                <div class="mt-1">
                                    @_validationError
                                </div>
                            </div>
                        }

                        <div class="d-grid d-sm-flex gap-2">

                            <button type="button"
                                    class="btn btn-primary btn-lg px-4"
                                    disabled="@(!CanVerify)"
                                    @onclick="VerifyAsync">

                                @if (_isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"
                                          aria-hidden="true">
                                    </span>

                                    <span>
                                        Verifying...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Verify label
                                    </span>
                                }

                            </button>

                            @if (_selectedFile is not null &&
                                 !_isProcessing)
                            {
                                <button type="button"
                                        class="btn btn-outline-secondary btn-lg"
                                        @onclick="ClearSelection">
                                    Clear
                                </button>
                            }

                        </div>

                        @if (_isProcessing)
                        {
                            <div class="alert alert-info mt-4 mb-0"
                                 role="status"
                                 aria-live="polite">

                                <div class="fw-semibold">
                                    Processing label
                                </div>

                                <div>
                                    The image is being validated, read by OCR,
                                    parsed, and compared with the application.
                                    This normally takes a few seconds.
                                </div>
                            </div>
                        }

                        @if (_submissionResult is not null &&
                             _submissionResult.ProcessingSucceeded &&
                             _submissionResult.Verification is not null)
                        {
                            var verification =
                                _submissionResult.Verification;

                            <div class="@GetOverallResultCss(
                                                                 verification.OverallStatus)"
                                 role="status"
                                 aria-live="polite">

                                <div class="fw-semibold">
                                    Automated verification status:
                                    @FormatStatus(
                                        verification.OverallStatus)
                                </div>

                                <div class="mt-1">
                                    @verification.PassCount passed,
                                    @verification.ReviewCount review,
                                    @verification.FailCount failed.
                                </div>

                                @if (_submissionResult.Telemetry is not null)
                                {
                                    var telemetry =
                                        _submissionResult.Telemetry;

                                    <div class="mt-2 small">

                                        <span class="fw-semibold">
                                            Total:
                                        </span>

                                        @FormatDuration(
                                            telemetry.TotalDuration)

                                        @if (telemetry.OcrDuration is not null)
                                        {
                                            <span class="ms-3">

                                                <span class="fw-semibold">
                                                    OCR:
                                                </span>

                                                @FormatDuration(
                                                    telemetry.OcrDuration.Value)

                                            </span>
                                        }

                                        @if (telemetry.VerificationDuration
                                             is not null)
                                        {
                                            <span class="ms-3">

                                                <span class="fw-semibold">
                                                    Verification:
                                                </span>

                                                @FormatDuration(
                                                    telemetry
                                                        .VerificationDuration
                                                        .Value)

                                            </span>
                                        }

                                    </div>
                                }

                                @if (verification.OverallStatus ==
                                     VerificationStatus.Review)
                                {
                                    <div class="mt-3 small">
                                        One or more fields contain ambiguous or
                                        insufficient evidence. Review the flagged
                                        fields below before making the final
                                        compliance determination.
                                    </div>
                                }
                            </div>

                            <VerificationCheckList Verification="verification" />
                        }
                    }
                    else
                    {
                        <BatchVerificationShell ApplicationId="@_selectedApplicationId" />
                    }

                </div>
            </div>

            @* ============================================================
               HUMAN AUTHORITY
               ============================================================ *@

            <div class="border rounded bg-body-tertiary p-3 mt-3 small">

                <div class="fw-semibold mb-1">
                    Human decision authority
                </div>

                <div class="text-secondary">
                    OCR and AI-assisted extraction provide evidence for review.
                    Deterministic rules perform objective comparisons.
                    These automated statuses are decision-support results and
                    do not replace the compliance agent's final determination.
                </div>

            </div>

        </div>
    </div>
</div>

@code {
    private const long MaxUploadBytes =
        10L * 1024L * 1024L;

    private static readonly IReadOnlyList<ApplicationOption>
        ApplicationOptions =
        [
            new(
                "COLA-84729",
                "COLA-84729")
        ];

    private string _selectedApplicationId =
        string.Empty;

    private IBrowserFile? _selectedFile;

    private bool _isProcessing;

    private string? _validationError;

    private LabelVerificationSubmissionResult?
        _submissionResult;

    private VerificationMode _verificationMode =
        VerificationMode.Single;

    private bool CanVerify =>
        !_isProcessing &&
        !string.IsNullOrWhiteSpace(
            _selectedApplicationId) &&
        _selectedFile is not null &&
        string.IsNullOrWhiteSpace(
            _validationError);

    private void SetVerificationMode(
        VerificationMode mode)
    {
        _verificationMode =
            mode;
    }

    

    private string GetModeIconContainerClass(
        VerificationMode mode)
    {
        var isSelected =
            _verificationMode ==
            mode;

        if (isSelected)
        {
            return
                "d-inline-flex align-items-center justify-content-center " +
                "rounded-circle bg-white bg-opacity-25 flex-shrink-0 " +
                "p-2";
        }

        return
            "d-inline-flex align-items-center justify-content-center " +
            "rounded-circle bg-body-tertiary flex-shrink-0 p-2";
    }

   // Returns the visual state for each verification-mode button.
//
// Important: do not add bg-white to outline buttons. Bootstrap's outline
// variants intentionally change both foreground and background colors on
// hover/focus. Forcing a white background can create white-on-white text.
private string GetModeButtonClass(
    VerificationMode mode)
{
    const string baseClasses =
        "btn w-100 d-flex align-items-center gap-3 p-3 " +
        "rounded-3 text-start shadow-sm";

    if (mode ==
        VerificationMode.Single)
    {
        return _verificationMode ==
               VerificationMode.Single
            ? $"{baseClasses} btn-primary"
            : $"{baseClasses} btn-outline-primary";
    }

    return _verificationMode ==
           VerificationMode.Batch
        ? $"{baseClasses} btn-success"
        : $"{baseClasses} btn-outline-success";
}

// Keep supporting text tied to the button's foreground color so it remains
// readable when Bootstrap changes the button color on hover and focus.
private string GetModeDescriptionClass(
    VerificationMode mode)
{
    return "d-block small opacity-75 mt-1";
}

    private void OnFileSelected(
        InputFileChangeEventArgs args)
    {
        _submissionResult =
            null;

        _validationError =
            null;

        var file =
            args.File;

        if (file.Size <= 0)
        {
            _selectedFile =
                null;

            _validationError =
                "The selected file is empty.";

            return;
        }

        if (file.Size >
            MaxUploadBytes)
        {
            _selectedFile =
                null;

            _validationError =
                $"The selected file is too large. " +
                $"Maximum size is {FormatFileSize(MaxUploadBytes)}.";

            return;
        }

        _selectedFile =
            file;
    }

    private async Task VerifyAsync()
    {
        if (_isProcessing)
        {
            return;
        }

        _submissionResult =
            null;

        _validationError =
            null;

        if (string.IsNullOrWhiteSpace(
                _selectedApplicationId))
        {
            _validationError =
                "Select an application before verification.";

            return;
        }

        if (_selectedFile is null)
        {
            _validationError =
                "Select a label image before verification.";

            return;
        }

        _isProcessing =
            true;

        try
        {
            await using var image =
                _selectedFile.OpenReadStream(
                    MaxUploadBytes);

            var result =
                await LabelVerificationService.VerifyAsync(
                    _selectedApplicationId,
                    image,
                    _selectedFile.Name,
                    _selectedFile.ContentType,
                    _selectedFile.Size);

            _submissionResult =
                result;

            if (!result.ProcessingSucceeded)
            {
                _validationError =
                    result.ErrorMessage ??
                    "The label could not be processed.";
            }
        }
        catch (LabelTextExtractionException exception)
        {
            Logger.LogWarning(
                exception,
                "OCR processing failed for application {ApplicationId}.",
                _selectedApplicationId);

            _validationError =
                "The label image could not be read by the OCR service. " +
                "Please try again or use a clearer image.";
        }
        catch (InvalidApplicationRecordException exception)
        {
            Logger.LogWarning(
                exception,
                "Application data was invalid for {ApplicationId}.",
                _selectedApplicationId);

            _validationError =
                "The selected application data could not be loaded safely.";
        }
        catch (IOException exception)
        {
            Logger.LogWarning(
                exception,
                "Unable to read uploaded label image.");

            _validationError =
                "The selected image could not be read. " +
                "Please choose the file again.";
        }
        catch (OperationCanceledException)
        {
            _validationError =
                "Verification was cancelled before processing completed.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unexpected label verification failure for application {ApplicationId}.",
                _selectedApplicationId);

            _validationError =
                "Verification could not be completed. Please try again.";
        }
        finally
        {
            _isProcessing =
                false;
        }
    }

    private void ClearSelection()
    {
        _selectedFile =
            null;

        _submissionResult =
            null;

        _validationError =
            null;
    }

    private static string FormatStatus(
        VerificationStatus status)
    {
        return status switch
        {
            VerificationStatus.Pass =>
                "PASS",

            VerificationStatus.Review =>
                "HUMAN REVIEW REQUIRED",

            VerificationStatus.Fail =>
                "FAIL",

            _ =>
                status
                    .ToString()
                    .ToUpperInvariant()
        };
    }

    private static string GetOverallResultCss(
        VerificationStatus status)
    {
        var alertClass =
            status switch
            {
                VerificationStatus.Pass =>
                    "alert-success",

                VerificationStatus.Review =>
                    "alert-warning",

                VerificationStatus.Fail =>
                    "alert-danger",

                _ =>
                    "alert-secondary"
            };

        return
            $"alert {alertClass} mt-4 mb-0";
    }

    private static string FormatDuration(
        TimeSpan duration)
    {
        if (duration.TotalSeconds >= 1)
        {
            return
                $"{duration.TotalSeconds:0.00} s";
        }

        return
            $"{duration.TotalMilliseconds:0} ms";
    }

    private static string FormatFileSize(
        long bytes)
    {
        const decimal bytesPerKilobyte =
            1024m;

        const decimal bytesPerMegabyte =
            1024m * 1024m;

        if (bytes >=
            bytesPerMegabyte)
        {
            return
                $"{bytes / bytesPerMegabyte:0.##} MB";
        }

        if (bytes >=
            bytesPerKilobyte)
        {
            return
                $"{bytes / bytesPerKilobyte:0.##} KB";
        }

        return
            $"{bytes} bytes";
    }

    private enum VerificationMode
    {
        Single,
        Batch
    }

    private sealed record ApplicationOption(
        string Id,
        string DisplayName);
}