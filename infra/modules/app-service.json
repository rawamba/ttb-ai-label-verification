{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "7134383185193755767"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Azure region used for App Service resources."
      }
    },
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Linux App Service Plan."
      }
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique name of the Web App."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "metadata": {
        "description": "App Service Plan SKU."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Tags applied to the App Service resources."
      }
    },
    "documentIntelligenceEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Document Intelligence endpoint used by the application."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "httpsOnly": true,
        "publicNetworkAccess": "Enabled",
        "siteConfig": {
          "linuxFxVersion": "DOTNETCORE|8.0",
          "alwaysOn": true,
          "http20Enabled": true,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "DocumentIntelligence__Endpoint",
              "value": "[parameters('documentIntelligenceEndpoint')]"
            },
            {
              "name": "DocumentIntelligence__ModelId",
              "value": "prebuilt-read"
            },
            {
              "name": "DocumentIntelligence__TimeoutSeconds",
              "value": "5"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the deployed Azure Web App."
      },
      "value": "[parameters('webAppName')]"
    },
    "webAppUrl": {
      "type": "string",
      "metadata": {
        "description": "Public HTTPS URL of the deployed Azure Web App."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01').defaultHostName)]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra principal ID of the Web App managed identity."
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-12-01', 'full').identity.principalId]"
    }
  }
}